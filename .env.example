# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Gemini
GEMINI_API_KEY=sua-chave-gemini

# WhatsApp Cloud API / Meta
WHATSAPP_ACCESS_TOKEN=seu-token
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
WHATSAPP_VERIFY_TOKEN=crie-um-token-de-verificacao
WHATSAPP_APP_SECRET=seu-app-secret

# Focus NFe (iniciar em homologacao)
FOCUS_NFE_TOKEN=seu-token-de-homologacao
FOCUS_NFE_ENVIRONMENT=homologacao

# Criptografia da senha do certificado A1
CERTIFICATE_ENCRYPTION_KEY=gere-uma-chave-forte
