# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-chave-publicavel
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
# Projetos novos também podem usar a chave secreta sb_secret_...
SUPABASE_SECRET_KEY=sua-chave-secreta

# Bootstrap local e temporário do primeiro administrador.
# Não configure estas quatro variáveis na Vercel. Remova a senha do .env.local após o uso.
BOOTSTRAP_ADMIN_EMAIL=admin@suaempresa.com.br
BOOTSTRAP_ADMIN_PASSWORD=use-uma-senha-forte-com-12-caracteres
BOOTSTRAP_ORGANIZATION_NAME=Sua Empresa
BOOTSTRAP_ORGANIZATION_SLUG=sua-empresa

# Gemini
# Segredo exclusivo do servidor. Nunca use o prefixo NEXT_PUBLIC_.
GEMINI_API_KEY=sua-chave-gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# WhatsApp Cloud API / Meta
WHATSAPP_ACCESS_TOKEN=seu-token
WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
WHATSAPP_VERIFY_TOKEN=crie-um-token-de-verificacao
WHATSAPP_APP_SECRET=seu-app-secret

# Focus NFe (iniciar em homologacao)
FOCUS_NFE_TOKEN=seu-token-de-homologacao
FOCUS_NFE_ENVIRONMENT=homologacao

# Criptografia da senha do certificado A1
CERTIFICATE_ENCRYPTION_KEY=gere-uma-chave-forte
