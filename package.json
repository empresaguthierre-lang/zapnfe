                         "next":  "16.3.2",
                         "react":  "19.2.8",
                         "react-dom":  "19.2.8",
                         "react-icons":  "^5.7.0",
                         "server-only":  "^0.0.1",
                         "zod":  "^4.4.3"
                     },
    "devDependencies":  {
