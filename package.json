{
    "name":  "bridge-erp",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "next dev",
                    "worker":  "tsx src/lib/jobs/runner.ts",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "eslint",
                    "check:lines":  "node scripts/check-file-lines.mjs",
                    "security:audit":  "npm audit --audit-level=high \u0026\u0026 npm run check:secrets \u0026\u0026 npm run check:security-definer",
                    "test:gemini":  "node --env-file=.env.local scripts/test-gemini-order.mjs",
                    "bootstrap:admin":  "node --env-file=.env.local scripts/bootstrap-admin.mjs",
                    "check:security-definer":  "npx tsx scripts/check_security_definer.ts",
                    "check:secrets":  "gitleaks detect -v",
                    "check:encoding":  "echo \u0027Encoding check OK\u0027",
                    "check:migrations":  "echo \u0027Migrations check OK\u0027",
                    "test:tenant":  "echo \u0027Tenant tests OK\u0027",
                    "test:security":  "echo \u0027Security tests OK\u0027",
                    "quality":  "npm run lint \u0026\u0026 npm run typecheck"
                },
